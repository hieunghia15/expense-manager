{% extends 'layouts/app.html.twig' %}

{% block title %}{{ title is defined ? title : 'Thêm danh mục mới' }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <!-- Back & Title Header -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <a href="/categories" class="btn btn-sm btn-light border text-secondary rounded-2 px-2.5 py-1.5" data-bs-toggle="tooltip" title="Quay lại">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h4 fw-bold text-dark mb-0">Thêm danh mục mới</h1>
                <p class="text-muted small mb-0">Tạo phân loại mới cho nguồn thu hoặc khoản chi của bạn</p>
            </div>
        </div>

        <!-- Form Card -->
        <div class="card-custom">
            <div class="card-body p-4">
                <form action="/categories/create" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

                    <!-- Name Field -->
                    <div class="mb-3.5">
                        <label for="name" class="form-label fw-medium text-dark small mb-1.5">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control rounded-3 py-2 px-3 {% if errors is defined and errors.name is defined %}is-invalid{% endif %}" 
                               id="name" 
                               name="name" 
                               value="{{ category is defined and category.name is defined ? category.name : '' }}" 
                               placeholder="VD: Lương, Ăn uống, Mua sắm..." 
                               maxlength="100" 
                               required>
                        {% if errors is defined and errors.name is defined %}
                            <div class="invalid-feedback small">
                                {{ errors.name|join(', ') }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Type Field -->
                    <div class="mb-4">
                        <label for="type" class="form-label fw-medium text-dark small mb-1.5">
                            Loại danh mục <span class="text-danger">*</span>
                        </label>
                        <select class="form-select rounded-3 py-2 px-3 {% if errors is defined and errors.type is defined %}is-invalid{% endif %}" 
                                id="type" 
                                name="type" 
                                required>
                            <option value="" disabled {% if category is not defined or not category.type is defined %}selected{% endif %}>-- Chọn loại danh mục --</option>
                            <option value="expense" {% if category is defined and category.type is defined and category.type == 'expense' %}selected{% endif %}>Chi phí (Expense)</option>
                            <option value="income" {% if category is defined and category.type is defined and category.type == 'income' %}selected{% endif %}>Thu nhập (Income)</option>
                        </select>
                        {% if errors is defined and errors.type is defined %}
                            <div class="invalid-feedback small">
                                {{ errors.type|join(', ') }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a href="/categories" class="btn btn-light border text-secondary px-3 py-2 rounded-3">Hủy</a>
                        <button type="submit" class="btn btn-green px-4 py-2 rounded-3">
                            <i class="bi bi-check-lg me-1"></i> Lưu danh mục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
