<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ title is defined ? title : 'Expense Manager' }}{% endblock %}</title>

    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/app.css">

    <!-- jQuery 3.7.1 CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
</head>
<body class="min-vh-100 d-flex flex-column">

    <!-- Header Navigation -->
    <header class="navbar navbar-expand-md navbar-custom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold fs-5 text-dark" href="/">
                <span class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3 p-2 me-2" style="width: 36px; height: 36px;">
                    <i class="bi bi-wallet2 fs-6"></i>
                </span>
                Expense Manager
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-1 mt-2 mt-md-0">
                    <li class="nav-item">
                        <a class="nav-link active fw-medium text-success px-3 py-2 rounded-2 bg-success bg-opacity-10" href="/">
                            <i class="bi bi-tags me-1"></i> Danh mục
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="container my-4 flex-grow-1" style="max-width: 960px;">
        {% if flash is defined and flash %}
            <div class="alert alert-{{ flash.type == 'error' ? 'danger' : (flash.type == 'success' ? 'success' : 'info') }} alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                {% if flash.type == 'success' %}
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>
                {% elseif flash.type == 'error' %}
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>
                {% else %}
                    <i class="bi bi-info-circle-fill me-2 text-info"></i>
                {% endif %}
                {{ flash.message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top py-3 text-center text-muted mt-auto small">
        <div class="container">
            <span>&copy; {{ "now"|date("Y") }} Expense Manager. Simple & Modern Financial Tracker.</span>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Auto-dismiss Flash Messages after 3 Seconds -->
    <script>
        $(function () {
            const $flashAlert = $('.alert-dismissible');
            if ($flashAlert.length) {
                setTimeout(function () {
                    $flashAlert.fadeOut(500, function () {
                        $(this).remove();
                    });
                }, 4000);
            }
        });
    </script>

    {% block scripts %}{% endblock %}
</body>
</html>
