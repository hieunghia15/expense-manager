{% extends 'layouts/app.html.twig' %}

{% block title %}{{ title is defined ? title : 'Chỉnh sửa danh mục' }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-3">
            <a href="/categories" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <h2 class="h3 mb-0 fw-bold">Chỉnh sửa danh mục</h2>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form action="/categories/{{ category.id }}" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control {% if errors is defined and errors.name is defined %}is-invalid{% endif %}" 
                               id="name" 
                               name="name" 
                               value="{{ category.name }}" 
                               placeholder="VD: Lương, Ăn uống, Mua sắm..." 
                               maxlength="100" 
                               required>
                        {% if errors is defined and errors.name is defined %}
                            <div class="invalid-feedback">
                                {{ errors.name|join(', ') }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        <label for="type" class="form-label fw-semibold">
                            Loại danh mục <span class="text-danger">*</span>
                        </label>
                        <select class="form-select {% if errors is defined and errors.type is defined %}is-invalid{% endif %}" 
                                id="type" 
                                name="type" 
                                required>
                            <option value="income" {% if category.type == 'income' %}selected{% endif %}>Thu nhập (Income)</option>
                            <option value="expense" {% if category.type == 'expense' %}selected{% endif %}>Chi phí (Expense)</option>
                        </select>
                        {% if errors is defined and errors.type is defined %}
                            <div class="invalid-feedback">
                                {{ errors.type|join(', ') }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/categories" class="btn btn-light border">Hủy</a>
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="bi bi-save me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
